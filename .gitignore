###############################################################################
# Terraform
###############################################################################

# Local .terraform directories
**/.terraform/*

# Terraform lock files
**/.terraform.lock.hcl

# .tfstate files
**/*.tfstate
**/*.tfstate.*

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json


###############################################################################
# TFLint
###############################################################################

# Local tflint directories
**/.tflint/*

# Local tflint configuration
# The template ships none: in a scaffolded project the dsb CLI writes one into each environment directory
**/.tflint.hcl


###############################################################################
# Other
###############################################################################

# VScode files
**/.vscode/*

# MacOs specific files
**/.DS_Store
